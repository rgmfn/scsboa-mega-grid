package templates

templ Head() {
	<head>
		<meta charset="UTF-8"/>
		<title>SCSBOA Grid</title>
		<link href="https://cdn.datatables.net/v/dt/dt-3.1.3/datatables.min.css" rel="stylesheet"/>
		<script src="https://cdn.datatables.net/v/dt/dt-3.1.3/datatables.min.js"></script>
		<script src="https://cdn.datatables.net/columncontrol/2.1.2/js/dataTables.columnControl.min.js"></script>
		<script src="https://cdn.datatables.net/columncontrol/2.1.2/js/columnControl.dataTables.min.js"></script>
		<link rel="stylesheet" href="https://cdn.datatables.net/columncontrol/2.1.2/css/columnControl.dataTables.min.css"/>
        <script src="https://cdn.datatables.net/fixedcolumns/6.1.1/js/dataTables.fixedColumns.min.js"></script>
        <script src="https://cdn.datatables.net/fixedcolumns/6.1.1/js/fixedColumns.dataTables.min.js"></script>
		<link rel="stylesheet" href="https://cdn.datatables.net/fixedcolumns/6.1.1/css/fixedColumns.dataTables.min.css"/>
		<script src="script.js"></script>
        <style>
            .light-gray {
                background-color: #DADADA !important;
            }

            .gray {
                background-color: #BABABA !important;
            }

            .dark-gray {
                background-color: #9A9A9A !important;
            }
        </style>
		<script>
            window.onload = windowOnLoad;
        </script>
	</head>
}
